{
  "schemaVersion": 1,
  "id": "canvasdesk",
  "version": "${version}",
  "name": "Canvas Desk",
  "description": "Uma bancada modular de escribas: desenhe, escreva e compartilhe ideias em um canvas persistente.",
  "authors": ["Murillo"],
  "license": "MIT",
  "icon": "assets/canvasdesk/icon.png",
  "environment": "*",
  "mixins": ["canvasdesk.mixins.json", {"config":"canvasdesk.client.mixins.json","environment":"client"}],
  "entrypoints": {
    "main": ["br.com.murillo.canvasdesk.CanvasDesk"],
    "client": ["br.com.murillo.canvasdesk.client.CanvasDeskClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": ">=0.164.0+26.3"
  }
}
